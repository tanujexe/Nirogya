# ==============================================================================
# Nirogya Sathi / MediSense AI — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER commit secrets or keys)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.env
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend / Backend Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Python Runtime, Bytecode & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. Large Machine Learning Artifacts & Binaries (>100MB / GitHub limits)
# ------------------------------------------------------------------------------
# Serialized models and encoders
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.keras
*.onnx
*.cbm
*.model
*.pb
*.pt
*.pth

# Explicit model artifact folders
AI-model/model_artifacts/*.pkl
AI-model/artifacts/models/*.pkl

# Large Windows installers & executables
*.exe
*.dll
*.msi
tesseract-ocr-setup.exe
tesseract-setup.exe

# ------------------------------------------------------------------------------
# 5. Large Training Datasets (>100MB GitHub limit)
# ------------------------------------------------------------------------------
# Disease and symptoms dataset is ~190MB
*.csv.gz
*.csv.zip
*Disease and symptoms dataset.csv*
AI-model/data/raw/*.csv
AI-model/data/processed/

# Keep reference lookup datasets tracked
!AI-model/gwalior_doctors_dataset.csv
!AI-model/data/reference/gwalior_doctors_dataset.csv

# ------------------------------------------------------------------------------
# 6. Runtime Uploads, Buffers & User-Generated Data
# ------------------------------------------------------------------------------
uploads/*
*/uploads/*
!uploads/.gitkeep
!*/uploads/.gitkeep
tmp/
*/tmp/
temp/
*/temp/

# Log files
*.log
startup_log.txt
AI-model/startup_log.txt

# ------------------------------------------------------------------------------
# 7. Testing, Coverage & Profiling
# ------------------------------------------------------------------------------
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------------------------
# 8. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor directories and local history
.history/
*/.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
